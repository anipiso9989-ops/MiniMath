{
  "name": "minimath-workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --filter @mini/math build",
    "test": "pnpm build && node --test packages/math/tests/*.test.mjs",
    "test:browser": "pnpm build && node --test packages/math/tests/browser.mjs",
    "bench": "pnpm build && node --expose-gc benchmarks/run.mjs"
  },
  "devDependencies": {
    "@mini/math": "workspace:*",
    "@mathjax/src": "4.1.3",
    "esbuild": "0.28.2",
    "katex": "0.19.1",
    "playwright-core": "1.61.1",
    "typescript": "5.9.3"
  }
}
